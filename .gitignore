# ---------------------------------------------------------------------------
# Environment files: they hold secrets (APP_KEY, JWT_SECRET, DB and SMS
# credentials) and are NEVER committed. Only the template .env.example is.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
/envV2
/env*

# Keys, certificates and credentials
*.key
*.pem
*.p12
*.pfx
*.crt
/auth.json
/storage/*.key

# Database dumps and exports (may contain customer data)
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite-journal

# Dependencies and build output
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/uploads/*

# Laravel runtime files (the folders keep their own .gitignore)
/storage/pail
*.log

# Tests and tooling caches
/.phpunit.cache
.phpunit.result.cache
/coverage
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
.phpdoc/
/api-docs

# Editors, IDEs and AI assistants
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.antigravity
/.claude/settings.local.json

# Local VM / OS files
Homestead.json
Homestead.yaml
.DS_Store
Thumbs.db
