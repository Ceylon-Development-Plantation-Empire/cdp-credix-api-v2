APP_NAME="CDP Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Business timezone (Sri Lankan calendar days); the app itself always stores and computes in UTC.
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=credix_v2
DB_USERNAME=root
DB_PASSWORD=

# Stateless JWT API: no session storage. Production: cache, queue and locks on Redis.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =========================================================
# JWT AUTHENTICATION
# =========================================================
JWT_SECRET=
JWT_ALGO=HS256
# Token lifetime in minutes (24 hours)
JWT_TTL=1440
JWT_REFRESH_TTL=43200

# =========================================================
# CORS CONFIGURATION
# =========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true

# =========================================================
# FRONTEND URL (for email links)
# =========================================================
FRONTEND_URL=http://localhost:5173

# =========================================================
# SMS GATEWAY (Dialog)
# =========================================================
DIALOG_SMS_URL=https://esms.dialog.lk
DIALOG_SMS_SEND_URL=https://e-sms.dialog.lk/api/v2/sms
DIALOG_SMS_USERNAME=
DIALOG_SMS_PASSWORD=
DIALOG_SMS_MASK=
# Testing against real records: comma-separated handsets that receive EVERY SMS instead of
# the customer (ignored in production).
SMS_ALLOWED_NUMBERS=
# Local machine only: write OTP codes to storage/logs instead of texting them.
OTP_LOG_CODES_LOCALLY=false

# =========================================================
# DATABASE BACKUP (full path to mysqldump if not in PATH)
# =========================================================
MYSQL_DUMP_PATH=
